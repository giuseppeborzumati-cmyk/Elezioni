rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function roleIs(r) { return signedIn() && request.auth.token.role == r; }
    function commission() { return roleIs('COMMISSIONE'); }
    function staff() { return signedIn() && request.auth.token.role in ['COMMISSIONE','DIRIGENTE','VICEPRESIDE','DSGA','SEGRETERIA']; }

    match /artifacts/iis-levi-electoral-v3/public/data/config/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /artifacts/iis-levi-electoral-v3/public/data/{collectionId}/{docId} {
      allow read: if commission() && collectionId.matches('tokens_[0-9]{4}_[0-9]{4}');
      allow create: if commission()
        && collectionId.matches('tokens_[0-9]{4}_[0-9]{4}')
        && request.resource.data.keys().hasOnly(['nome','classe','indirizzo','tipo','hasVoted','voted_consiglio','voted_istituto','voted_consulta','voted_classe_studente','voted_classe_genitore'])
        && request.resource.data.tipo in ['STUDENTE','GENITORE','DOCENTE','ATA']
        && request.resource.data.hasVoted == false
        && request.resource.data.voted_consiglio == false
        && request.resource.data.voted_istituto == false
        && request.resource.data.voted_consulta == false
        && request.resource.data.voted_classe_studente == false
        && request.resource.data.voted_classe_genitore == false;
      allow update: if commission()
        && collectionId.matches('tokens_[0-9]{4}_[0-9]{4}')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome','classe','indirizzo','tipo']);
      allow delete: if false;

      allow read: if commission() && collectionId.matches('config_[0-9]{4}_[0-9]{4}');
      allow read: if commission() && collectionId.matches('gestione_accessi_[0-9]{4}_[0-9]{4}');
      allow write: if false;
    }

    match /artifacts/iis-levi-electoral-v3/public/data/audit_admin/{docId} {
      allow read: if staff();
      allow write: if false;
    }

    match /{document=**} { allow read, write: if false; }
  }
}
